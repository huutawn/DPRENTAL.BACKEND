# ==========================================
# Cấu hình môi trường ASP.NET Core & Cổng mạng
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
GATEWAY_PORT=8080

# ==========================================
# Cấu hình AuthService & JWT Authentication
# ==========================================
# Tên Issuer phát hành token từ AuthService (khớp với issuer của AuthService)
GATEWAY_JWT_ISSUER=dprental-authservice-dev

# Audience định danh đối tượng nhận token (khớp với audience của AuthService)
GATEWAY_JWT_AUDIENCE=dprental-clients

# URL endpoint JWKS của AuthService để Gateway tải public key xác thực
GATEWAY_JWKS_URI=http://auth-service:5000/.well-known/jwks.json

# ==========================================
# Cấu hình Reverse Proxy Downstream Clusters
# ==========================================
# Địa chỉ nội bộ của AuthService mà Gateway chuyển tiếp tới
AUTH_SERVICE_UPSTREAM_URL=http://auth-service:5000/

# ==========================================
# Cấu hình Bảo mật (Security & CORS)
# ==========================================
# Danh sách Origin được phép gọi Gateway qua CORS
CORS_ALLOWED_ORIGIN_0=http://localhost:3000
CORS_ALLOWED_ORIGIN_1=http://localhost:5173

# Giới hạn kích thước payload tối đa tính bằng byte (10 MB = 10485760)
MAX_REQUEST_BODY_SIZE_BYTES=10485760

# ==========================================
# Cấu hình Phục hồi & Điều phối lưu lượng (Resilience & Traffic)
# ==========================================
# Thời gian chờ tối đa khi chuyển tiếp tới upstream trước khi trả 504 (giây)
DEFAULT_TIMEOUT_SECONDS=10

# Hạn mức request ẩn danh theo IP (request/phút)
RATE_LIMIT_ANONYMOUS_PERMIT=20

# Hạn mức request người dùng đã đăng nhập theo UserId (request/phút)
RATE_LIMIT_AUTHENTICATED_PERMIT=100

# Hạn mức request cho các endpoint nhạy cảm (request/phút)
RATE_LIMIT_SENSITIVE_PERMIT=5

# ==========================================
# Cấu hình Distributed Tracing (Tùy chọn)
# ==========================================
# Tỷ lệ lấy mẫu trace gốc (1.0 = 100%, 0.1 = 10%)
TRACING_SAMPLING_RATIO=1.0

# Endpoint OTLP collector (để trống nếu chạy local không có collector)
OTLP_TRACES_ENDPOINT=
