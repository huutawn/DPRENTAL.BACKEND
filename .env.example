# Biến môi trường dành riêng cho Docker Compose (PostgreSQL và MinIO)
# KHÔNG dùng file này trực tiếp cho dotnet run.
# Đối với dotnet run cục bộ, hãy cấu hình qua .NET User Secrets theo hướng dẫn trong README.md.

POSTGRES_DB=mediaservice
POSTGRES_USER=mediaservice
POSTGRES_PASSWORD=mediasecret
POSTGRES_PORT=5434

MINIO_ROOT_USER=mediaadmin
MINIO_ROOT_PASSWORD=mediasecretpassword
MINIO_BUCKET=dprental-media
MINIO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
