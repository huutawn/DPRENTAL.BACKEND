POSTGRES_DB=catalogservice
POSTGRES_USER=catalogservice
POSTGRES_PASSWORD=dprental
POSTGRES_PORT=27297

# Cấu hình JWT (RS256): Catalog tải public key từ JWKS của AuthService
Auth__Jwt__Issuer=dprental-authservice-dev
Auth__Jwt__Audience=dprental-clients
# Docker network dùng http://auth-service:8080/.well-known/jwks.json; chạy trên host dùng cổng local của AuthService.
Auth__Jwt__JwksUri=http://localhost:64837/.well-known/jwks.json

# OpenTelemetry OTLP Traces Collector (để trống khi chưa có collector)
Telemetry__Otlp__TracesEndpoint=
