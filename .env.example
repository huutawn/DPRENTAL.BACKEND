POSTGRES_DB=authservice
POSTGRES_USER=authservice
POSTGRES_PASSWORD=dprental

# Khóa bí mật dùng để bootstrap Super Admin qua POST /api/v1/auth/admins (bắt buộc khi chạy API)
Auth__AdminBootstrap__CreationKey=replace-with-a-secure-random-key

# AuthService gọi MediaService qua Gateway khi chạy trực tiếp trên host.
# Đặt cùng secret với MediaService ApiKey; với Docker network dùng http://media-service:8080.
MediaService__InternalBaseUrl=http://localhost:5050
MediaService__PublicGatewayUrl=http://localhost:5050
MediaService__ApiKey=replace-with-the-media-service-api-key
