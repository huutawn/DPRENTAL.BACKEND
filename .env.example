# ==============================================================================
# DPRENTAL API Gateway - Biến môi trường cấu hình động (Dynamic Environment Variables)
# ==============================================================================

# ==============================================================================
# 1. Cấu hình Gateway Server
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Development
# Cổng lắng nghe của Gateway:
# - Chạy bình thường trên máy host: 5050
# - Chạy trong Docker container: 8080 (hoặc map ra cổng ngoài tùy ý)
GATEWAY_PORT=5050
ASPNETCORE_URLS=http://+:8080

# ==============================================================================
# 2. Cấu hình kết nối AuthService (Tùy biến linh hoạt theo môi trường chạy)
# ==============================================================================
# CHỌN MỘT TRONG CÁC CHẾ ĐỘ DƯỚI ĐÂY:
#
# [Chế độ 1: Chạy bình thường trên máy host (Local Development, không dùng Docker)]
#   - AUTH_SERVICE_HOST=localhost
#   - AUTH_SERVICE_PORT=64837   (Khớp với launchSettings.json của AuthService: http://localhost:64837)
#
# [Chế độ 2: Chạy Docker chung 1 mạng (Shared Docker Network, ví dụ: dprental-network)]
#   - AUTH_SERVICE_HOST=auth-service   (Tên service / container trong Docker network)
#   - AUTH_SERVICE_PORT=5000           (Cổng container nội bộ của AuthService)
#
# [Chế độ 3: Chạy Gateway trong Docker nhưng AuthService chạy trực tiếp trên máy host]
#   - AUTH_SERVICE_HOST=host.docker.internal
#   - AUTH_SERVICE_PORT=64837
#
AUTH_SERVICE_SCHEME=http
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=64837

# Cấu hình host, port, scheme được ánh xạ vào các routes Ocelot trong docker-compose.yml:
# ==============================================================================
# 3. Cấu hình JWT Authentication & JWKS
# ==============================================================================
# Tên Issuer phát hành token từ AuthService (khớp với appsettings của AuthService)
GATEWAY_JWT_ISSUER=dprental-authservice-dev

# Audience định danh đối tượng nhận token (khớp với appsettings của AuthService)
GATEWAY_JWT_AUDIENCE=dprental-clients

# Endpoint tải public key JWKS (Tự động ghép theo host:port của AuthService hoặc ghi đè):
GATEWAY_JWKS_URI=http://${AUTH_SERVICE_HOST}:${AUTH_SERVICE_PORT}/.well-known/jwks.json

# ==============================================================================
# 4. Cấu hình Bảo mật & CORS Whitelist
# ==============================================================================
# Danh sách Origin được phép gọi Gateway qua CORS (Front-end Web / Mobile Web)
CORS_ALLOWED_ORIGIN_0=http://localhost:3000
CORS_ALLOWED_ORIGIN_1=http://localhost:5173

# Giới hạn kích thước thân request tối đa tính bằng byte (10 MB = 10485760)
MAX_REQUEST_BODY_SIZE_BYTES=10485760

# ==============================================================================
# 5. Cấu hình Phục hồi & Điều phối lưu lượng (Resilience & Traffic Control)
# ==============================================================================
# Thời gian chờ tối đa khi chuyển tiếp tới upstream trước khi Ocelot trả 503 (giây)
DEFAULT_TIMEOUT_SECONDS=10

# Hạn mức request ẩn danh theo IP (request/phút)
RATE_LIMIT_ANONYMOUS_PERMIT=20

# Hạn mức request người dùng đã đăng nhập theo UserId (request/phút)
RATE_LIMIT_AUTHENTICATED_PERMIT=100

# Hạn mức request cho các endpoint nhạy cảm (đăng nhập, session) (request/phút)
RATE_LIMIT_SENSITIVE_PERMIT=5

# ==========================================
# 6. Cấu hình Distributed Tracing (Tùy chọn)
# ==========================================
# Tỷ lệ lấy mẫu trace gốc (1.0 = 100%, 0.1 = 10%)
TRACING_SAMPLING_RATIO=1.0

# Endpoint OTLP collector (để trống nếu chạy local không có collector)
OTLP_TRACES_ENDPOINT=
