# Copy to .env before starting the root Compose stack.
# The root .gitignore excludes .env; do not commit it.
ASPNETCORE_ENVIRONMENT=Development
GATEWAY_PORT=5050

POSTGRES_DB=authservice
POSTGRES_USER=authservice
POSTGRES_PASSWORD=replace-with-a-local-development-password
DPRENTAL_POSTGRES_HOST_PORT=55432
DPRENTAL_VALKEY_HOST_PORT=56379
DPRENTAL_KAFKA_HOST_PORT=29092
KAFKA_NUM_PARTITIONS=3

AUTH_JWT_ISSUER=dprental-authservice-dev
AUTH_JWT_AUDIENCE=dprental-clients
AUTH_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
AUTH_JWT_ACTIVE_KEY_ID=local-2026-01

# The local Compose stack generates a 3072-bit development key pair once in its
# Docker volume. Do not use that mechanism for production deployments.
# AuthService migrations are applied automatically by the auth-migrate job.

CORS_ALLOWED_ORIGIN_0=http://localhost:3000
CORS_ALLOWED_ORIGIN_1=http://localhost:5173
MAX_REQUEST_BODY_SIZE_BYTES=10485760
DEFAULT_TIMEOUT_SECONDS=10
RATE_LIMIT_ANONYMOUS_PERMIT=20
RATE_LIMIT_AUTHENTICATED_PERMIT=100
RATE_LIMIT_SENSITIVE_PERMIT=5
TRACING_SAMPLING_RATIO=1.0
OTLP_TRACES_ENDPOINT=
