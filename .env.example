# PostgreSQL
POSTGRES_DB=recommendationservice
POSTGRES_USER=recommendationservice
POSTGRES_PASSWORD=recommendationservice_secret_password
POSTGRES_PORT=24336

# API host port
API_PORT=8080

# Published ports on host machine (for dotnet run on host)
KAFKA_PORT=29092
VALKEY_PORT=6379

# Container endpoint overrides for Compose (optional; defaults inside container network are kafka:9092 and valkey:6379)
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# VALKEY_CONNECTION_STRING=valkey:6379
