{
    email {$CADDY_ACME_EMAIL}
}

{$DEV_DOMAIN} {
    encode zstd gzip

    @mediaStorage path /dprental-media/*
    handle @mediaStorage {
        reverse_proxy media-minio:9000
    }

    handle {
        reverse_proxy gateway:8080
    }
}

{$DEV_APP_DOMAIN} {
    encode zstd gzip
    reverse_proxy frontend:3000 {
        header_up Host {http.request.host}
        header_up X-Forwarded-Proto https
    }
}
