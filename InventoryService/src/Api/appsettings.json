{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "InventoryCache": {
    "Enabled": false,
    "TtlSeconds": 60,
    "TimeoutMs": 500
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "http://localhost:5000",
      "HumanAudience": "dprental-clients",
      "ServiceAudience": "inventory-api",
      "JwksUri": "http://localhost:5000/.well-known/jwks.json",
      "TimeoutSeconds": 5,
      "CacheDurationMinutes": 5,
      "MaxStaleMinutes": 10
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ClientId": "inventory-service",
    "DeliveryTimeoutMs": 15000,
    "Acks": "all",
    "EnableIdempotence": true,
    "AutoProvisionTopics": true,
    "DefaultPartitions": 3,
    "DefaultReplicationFactor": 1
  },
  "MediaService": {
    "InternalBaseUrl": "http://media-service:8080",
    "PublicGatewayUrl": "https://gateway.example",
    "ApiKey": "",
    "TimeoutSeconds": 10
  },
  "CatalogService": {
    "BaseUrl": "http://catalog-service:8080",
    "TimeoutSeconds": 10
  }
}
