{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "",
    "RecommendationRedis": ""
  },
  "InventoryCache": {
    "Enabled": false,
    "DynamicTtlSeconds": 15,
    "MetadataTtlSeconds": 120,
    "CatalogTtlSeconds": 120,
    "TimeoutMs": 100
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "http://localhost:5000",
      "HumanAudience": "dprental-clients",
      "ServiceAudience": "inventory-api",
      "JwksUri": "http://localhost:5000/.well-known/jwks.json",
      "TimeoutSeconds": 5,
      "CacheDurationMinutes": 5,
      "MaxStaleMinutes": 10
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ClientId": "inventory-service",
    "DeliveryTimeoutMs": 15000,
    "Acks": "all",
    "EnableIdempotence": true,
    "AutoProvisionTopics": true,
    "DefaultPartitions": 3,
    "DefaultReplicationFactor": 1
  },
  "MediaService": {
    "InternalBaseUrl": "http://media-service:8080",
    "PublicGatewayUrl": "https://gateway.example",
    "ApiKey": "",
    "TimeoutSeconds": 10
  },
  "CatalogService": {
    "BaseUrl": "http://catalog-service:8080",
    "TimeoutSeconds": 10
  },
  "Meilisearch": {
    "Url": "http://localhost:7700",
    "ApiKey": "",
    "TimeoutSeconds": 5,
    "CandidateLimit": 5000,
    "PublicListingsIndex": "inventory_public_listings",
    "OwnerListingsIndex": "inventory_owner_listings",
    "OwnerAssetsIndex": "inventory_owner_assets"
  }
}
