{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "AutoProvisionTopics": false
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "http://auth-service:5000",
      "HumanAudience": "dprental-clients",
      "ServiceAudience": "inventory-api",
      "JwksUri": "http://auth-service:5000/.well-known/jwks.json",
      "TimeoutSeconds": 5,
      "CacheDurationMinutes": 5,
      "MaxStaleMinutes": 10
    }
  },
  "MediaService": {
    "InternalBaseUrl": "http://media-service:8080",
    "PublicGatewayUrl": "https://gateway.example",
    "ApiKey": "",
    "TimeoutSeconds": 10
  },
  "CatalogService": {
    "BaseUrl": "http://catalog-service:8080",
    "TimeoutSeconds": 10
  },
  "Meilisearch": {
    "Url": "http://meilisearch:7700",
    "ApiKey": "",
    "TimeoutSeconds": 5,
    "CandidateLimit": 5000,
    "PublicListingsIndex": "inventory_public_listings",
    "OwnerListingsIndex": "inventory_owner_listings",
    "OwnerAssetsIndex": "inventory_owner_assets"
  }
}
