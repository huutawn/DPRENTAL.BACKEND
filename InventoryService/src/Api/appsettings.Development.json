{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "http://localhost:5000",
      "HumanAudience": "dprental-clients",
      "ServiceAudience": "inventory-api",
      "JwksUri": "http://localhost:5000/.well-known/jwks.json",
      "TimeoutSeconds": 5,
      "CacheDurationMinutes": 5,
      "MaxStaleMinutes": 10
    }
  }
}
