{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "dprental-authservice-dev",
      "Audience": "dprental-clients",
      "JwksUri": "http://auth-service:8080/.well-known/jwks.json",
      "TimeoutSeconds": 10,
      "MaxStaleMinutes": 60
    }
  }
}
