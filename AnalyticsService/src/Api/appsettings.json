{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "",
    "ClientId": "analytics-service",
    "ConsumerGroupId": "analytics-service",
    "RentalEventsTopic": "rental.events.v1",
    "PaymentEventsTopic": "payment.events.v1",
    "RetryInitialDelayMilliseconds": 500,
    "RetryMaxDelaySeconds": 30
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "dprental-authservice-dev",
      "ClientAudience": "dprental-clients",
      "JwksUri": "http://auth-service:8080/.well-known/jwks.json"
    }
  },
  "AnalyticsHub": {
    "HubPath": "/hubs/analytics",
    "AllowedOrigins": []
  }
}
