{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Issuer": "dprental-authservice-dev",
      "Audience": "dprental-clients",
      "JwksUri": "http://auth-service:8080/.well-known/jwks.json"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "",
    "GroupId": "analytics-dashboard-v1",
    "RentalTopic": "rental.events.v1",
    "PaymentTopic": "payment.analytics.v1",
    "ProofIssuer": "dprental-integrity-host",
    "ProofEnvironment": "production",
    "ProofPublicKeys": {}
  }
}
