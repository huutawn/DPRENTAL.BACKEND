{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dprental.vn/contracts/events/rental-order-paid-v1.json",
  "title": "RentalOrderPaidPayload",
  "type": "object",
  "required": [
    "rentalOrderId",
    "renterId",
    "invoiceRef",
    "paymentRef",
    "paidAmount",
    "paidAt"
  ],
  "properties": {
    "rentalOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "renterId": {
      "type": "string",
      "format": "uuid"
    },
    "invoiceRef": {
      "type": "string",
      "minLength": 1
    },
    "paymentRef": {
      "type": "string",
      "minLength": 1
    },
    "paidAmount": {
      "type": "number",
      "minimum": 0
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    },
    "orderVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
