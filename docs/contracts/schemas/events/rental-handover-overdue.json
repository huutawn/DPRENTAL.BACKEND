{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dprental.vn/contracts/events/rental-handover-overdue-v1.json",
  "title": "RentalHandoverOverduePayload",
  "type": "object",
  "required": [
    "rentalOrderId",
    "rentalItemId",
    "supplierId",
    "renterId",
    "expectedStartDate",
    "overdueAt"
  ],
  "properties": {
    "rentalOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "rentalItemId": {
      "type": "string",
      "format": "uuid"
    },
    "supplierId": {
      "type": "string",
      "format": "uuid"
    },
    "renterId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedStartDate": {
      "type": "string",
      "format": "date"
    },
    "overdueAt": {
      "type": "string",
      "format": "date-time"
    },
    "orderVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
