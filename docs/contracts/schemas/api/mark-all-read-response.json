{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dprental.vn/contracts/api/mark-all-read-response-v1.json",
  "title": "MarkAllReadResponse",
  "type": "object",
  "required": ["markedCount", "cutoffUtc", "readAt"],
  "properties": {
    "markedCount": {
      "type": "integer",
      "minimum": 0
