{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dprental.com/contracts/schemas/search-performed.schema.json",
  "title": "SearchPerformed",
  "description": "Event emitted by InventoryService when a search on page 1 succeeds with query text or filter.",
  "type": "object",
  "required": [
    "messageId",
    "messageType",
    "version",
    "producer",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "messageType": {
      "type": "string",
      "const": "SearchPerformed"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "producer": {
      "type": "string",
      "const": "InventoryService"
    },
    "occurredAt": {
      "$ref": "#/$defs/utcIso8601Timestamp"
    },
    "correlationId": {
      "$ref": "#/$defs/nullableCorrelationId"
    },
    "payload": {
      "type": "object",
      "required": [
        "userId",
        "equipmentTypeId"
      ],
      "additionalProperties": false,
      "properties": {
        "userId": {
          "$ref": "#/$defs/nullableNonNilUuid"
        },
        "equipmentTypeId": {
          "$ref": "#/$defs/nullableNonNilUuid"
        }
      }
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "nullableNonNilUuid": {
      "type": ["string", "null"],
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "utcIso8601Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "nullableCorrelationId": {
      "type": ["string", "null"],
      "minLength": 1
    }
  }
}
