{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dprental.com/contracts/schemas/rental-item-completed.schema.json",
  "title": "RentalItemCompleted",
  "description": "Event emitted by RentalService when an item transitions to Completed status.",
  "type": "object",
  "required": [
    "messageId",
    "messageType",
    "version",
    "producer",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "messageType": {
      "type": "string",
      "const": "RentalItemCompleted"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "producer": {
      "type": "string",
      "const": "RentalService"
    },
    "occurredAt": {
      "$ref": "#/$defs/utcIso8601Timestamp"
    },
    "correlationId": {
      "$ref": "#/$defs/nullableCorrelationId"
    },
    "payload": {
      "type": "object",
      "required": [
        "equipmentListingId",
        "equipmentTypeId",
        "rentalOrderId",
        "rentalItemId"
      ],
      "additionalProperties": false,
      "properties": {
        "equipmentListingId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "equipmentTypeId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "rentalOrderId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "rentalItemId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "userId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "renterId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "$ref": "#/$defs/utcIso8601Timestamp"
        }
      },
      "oneOf": [
        {
          "required": [
            "userId"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "renterId"
                ]
              },
              {
                "required": [
                  "quantity"
                ]
              },
              {
                "required": [
                  "occurredAt"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "renterId",
            "quantity",
            "occurredAt"
          ],
          "not": {
            "required": [
              "userId"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "utcIso8601Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "nullableCorrelationId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
