{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Auth": {
      "BaseUrl": "http://auth-service:8080"
    },
    "Inventory": {
      "BaseUrl": "http://inventory-service:8080"
    },
    "Payment": {
      "BaseUrl": "http://payment-service:8080"
    },
    "Media": {
      "BaseUrl": "http://media-service:8080"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Rental": {
    "Terms": {
      "CurrentVersion": "",
      "DocumentRef": "",
      "ContentHash": ""
    },
    "OverdueProtection": {
      "Enabled": true,
      "ScanIntervalSeconds": 60,
      "BatchSize": 50
    },
    "HandoverOverdue": {
      "Enabled": true,
      "ScanIntervalSeconds": 60,
      "BatchSize": 50,
      "AutoExpireGraceHours": 24
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "dprental-authservice-dev",
      "Audience": "dprental-clients",
      "JwksUri": "http://auth-service:8080/.well-known/jwks.json"
    }
  }
}
