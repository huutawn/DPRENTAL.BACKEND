  "required": ["mediaId", "url", "expiresAtUtc"],
  "properties": {
    "mediaId": { "type": "string", "format": "uuid" },
    "url": { "type": "string", "format": "uri" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  }
}
