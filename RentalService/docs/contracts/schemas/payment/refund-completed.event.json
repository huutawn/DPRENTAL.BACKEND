{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefundCompletedEventEnvelope",
  "type": "object",
  "required": [
    "messageId",
    "messageType",
    "version",
    "producer",
    "aggregateId",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "type": "string", "const": "RefundCompleted" },
    "version": { "type": "integer", "const": 1 },
    "producer": { "type": "string" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "payload": {
      "type": "object",
      "required": [
        "rentalOrderId",
        "invoiceRef",
        "paymentRef",
        "refundRef",
        "operationKey",
        "totalRefundedAmount",
        "currency",
        "items",
        "completedAt"
      ],
      "properties": {
        "rentalOrderId": { "type": "string", "format": "uuid" },
        "invoiceRef": { "type": "string" },
        "paymentRef": { "type": "string" },
        "refundRef": { "type": "string" },
        "operationKey": { "type": "string" },
        "totalRefundedAmount": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "completedAt": { "type": "string", "format": "date-time" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["rentalItemId", "refundedRentalAmount", "refundedDepositAmount"],
            "properties": {
              "rentalItemId": { "type": "string", "format": "uuid" },
              "refundedRentalAmount": { "type": "integer", "minimum": 0 },
              "refundedDepositAmount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
