{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequestRefundResponse",
  "type": "object",
  "required": ["refundRef", "operationKey", "status", "totalRefundAmount", "currency", "isReplay"],
  "properties": {
    "refundRef": { "type": "string" },
    "operationKey": { "type": "string" },
    "status": { "type": "string", "enum": ["Accepted"] },
    "totalRefundAmount": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "isReplay": { "type": "boolean" }
  }
}
