<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Api/RentalService.Api.csproj" />
    <ProjectReference Include="../../src/Application/RentalService.Application.csproj" />
    <ProjectReference Include="../../src/Domain/RentalService.Domain.csproj" />
  </ItemGroup>
  <!-- Test E2E Rental -> Recommendation cần code Recommendation đặt cạnh repo (D:\RecommendationService).
       Không có thư mục đó thì bỏ file test E2E ra khỏi build, coi như skip. -->
  <PropertyGroup>
    <RecommendationServiceSrc>$(MSBuildThisFileDirectory)../../../../RecommendationService/RecommendationService/src/</RecommendationServiceSrc>
    <HasRecommendationService Condition="Exists('$(RecommendationServiceSrc)Application/RecommendationService.Application.csproj')">true</HasRecommendationService>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasRecommendationService)' == 'true'">
    <ProjectReference Include="$(RecommendationServiceSrc)Application/RecommendationService.Application.csproj" />
    <ProjectReference Include="$(RecommendationServiceSrc)Domain/RecommendationService.Domain.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(HasRecommendationService)' != 'true'">
    <Compile Remove="Integration/RentalToRecommendationE2EIntegrationTests.cs" />
  </ItemGroup>
</Project>
