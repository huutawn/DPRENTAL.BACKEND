{
  "Gateway": {
    "Authentication": {
      "Jwt": {
        "Issuer": "dprental-authservice-dev",
        "Audience": "dprental-clients",
        "JwksUri": "http://localhost:5000/.well-known/jwks.json"
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-service": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5000/"
          }
        }
      }
    }
  }
}
