{
  "Telemetry": {
    "Tracing": {
      "SamplingRatio": 1.0
    }
  },
  "Gateway": {
    "Authentication": {
      "Jwt": {
        "Issuer": "dprental-authservice-dev",
        "Audience": "dprental-clients",
        "JwksUri": "http://localhost:5000/.well-known/jwks.json"
      }
    },
    "Security": {
      "Cors": {
        "AllowedOrigins": [
          "http://localhost:3000",
          "http://localhost:5173"
        ]
      }
    },
    "Traffic": {
      "Resilience": {
        "DefaultTimeoutSeconds": 15
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-service": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5000/"
          }
        }
      }
    }
  }
}
