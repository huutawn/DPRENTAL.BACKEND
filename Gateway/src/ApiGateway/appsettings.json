{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Tracing": {
      "SamplingRatio": 0.1
    },
    "Otlp": {
      "TracesEndpoint": ""
    }
  },
  "Gateway": {
    "Observability": {
      "Logging": {
        "Enabled": true,
        "IncludeQueryString": false,
        "RedactedHeaderNames": [
          "Authorization",
          "Proxy-Authorization",
          "Cookie",
          "Set-Cookie",
          "X-Api-Key",
          "token",
          "password",
          "secret"
        ]
      },
      "Metrics": {
        "Enabled": true
      }
    },
    "Authentication": {
      "Jwt": {
        "Issuer": "",
        "Audience": "",
        "JwksUri": ""
      }
    },
    "Security": {
      "Cors": {
        "AllowedOrigins": [],
        "AllowedMethods": [
          "GET",
          "POST",
          "PUT",
          "DELETE",
          "PATCH",
          "OPTIONS",
          "HEAD"
        ],
        "AllowedHeaders": [
          "Authorization",
          "Content-Type",
          "X-Correlation-ID",
          "Accept",
          "Origin",
          "X-Requested-With"
        ],
        "ExposedHeaders": [
          "X-Correlation-ID"
        ],
        "AllowCredentials": true,
        "PreflightMaxAgeSeconds": 3600
      },
      "ForwardedHeaders": {
        "Enabled": true,
        "ForwardLimit": 1,
        "KnownNetworks": [],
        "KnownProxies": []
      },
      "RequestSize": {
        "MaxRequestBodySizeBytes": 10485760
      },
      "Headers": {
        "EnableContentTypeOptions": true,
        "EnableFrameOptions": true,
        "FrameOptions": "DENY",
        "EnableXssProtection": true,
        "XssProtection": "0",
        "EnableReferrerPolicy": true,
        "ReferrerPolicy": "strict-origin-when-cross-origin",
        "EnableContentSecurityPolicy": true,
        "ContentSecurityPolicy": "default-src 'self'; frame-ancestors 'none';",
        "EnableStrictTransportSecurity": true,
        "HstsMaxAgeSeconds": 31536000,
        "HstsIncludeSubDomains": true
      },
      "Identity": {
        "ServiceName": "ApiGateway"
      }
    },
    "Traffic": {
      "Resilience": {
        "DefaultTimeoutSeconds": 10,
        "AllowUnsafeCommandRetries": false
      },
      "RateLimiting": {
        "Enabled": true,
        "Anonymous": {
          "PermitLimit": 20,
          "WindowSeconds": 60,
          "QueueLimit": 0
        },
        "Authenticated": {
          "PermitLimit": 100,
          "WindowSeconds": 60,
          "QueueLimit": 0
        },
        "Sensitive": {
          "PermitLimit": 5,
          "WindowSeconds": 60,
          "QueueLimit": 0
        },
        "SensitivePaths": [
          "/api/v1/auth/sessions",
          "/api/v1/auth/login",
          "/api/v1/auth/tokens"
        ]
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-service": {
        "ClusterId": "auth-service",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/auth"
          }
        ]
      }
    },
    "Clusters": {
      "auth-service": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      }
    }
  }
}
