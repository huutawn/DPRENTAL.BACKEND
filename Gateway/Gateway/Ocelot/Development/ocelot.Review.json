{
  "Routes": [
    {
      "Key": "review-public-listings",
      "UpstreamPathTemplate": "/api/v1/reviews/listings/{listingId}",
      "DownstreamPathTemplate": "/api/v1/reviews/listings/{listingId}",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "review-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      },
      "Priority": 10
    },
    {
