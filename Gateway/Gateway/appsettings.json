{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Authentication": {
      "ApiKey": {
        "RequiredRoutes": [
          "GET /api/v1/media/*/verify",
          "GET /api/v1/media/*",
          "POST /api/v1/media/*/access",
          "PUT /api/v1/media/*/visibility"
        ]
      },
      "Jwt": {
        "Issuer": "",
        "Audience": "",
        "InventoryAudience": "inventory-api",
        "JwksUri": ""
      }
    },
    "Security": {
      "Cors": {
        "AllowedOrigins": [],
        "AllowedMethods": [
          "GET",
          "POST",
          "PUT",
          "DELETE",
          "PATCH",
          "OPTIONS",
          "HEAD"
        ],
        "AllowedHeaders": [
          "Authorization",
          "Content-Type",
          "Idempotency-Key",
          "X-Correlation-ID",
          "Accept",
          "Origin",
          "X-Requested-With"
        ],
        "ExposedHeaders": [
          "X-Correlation-ID",
          "Retry-After"
        ],
        "AllowCredentials": true,
        "PreflightMaxAgeSeconds": 3600
      },
      "ForwardedHeaders": {
        "Enabled": true,
        "ForwardLimit": 1,
        "KnownNetworks": [],
        "KnownProxies": []
      },
      "RequestSize": {
        "MaxRequestBodySizeBytes": 10485760,
        "MediaUploadMaxRequestBodySizeBytes": 26214400
      },
      "Headers": {
        "EnableContentTypeOptions": true,
        "EnableFrameOptions": true,
        "FrameOptions": "DENY",
        "EnableXssProtection": true,
        "XssProtection": "0",
        "EnableReferrerPolicy": true,
        "ReferrerPolicy": "strict-origin-when-cross-origin",
        "EnableContentSecurityPolicy": true,
        "ContentSecurityPolicy": "default-src 'self'; frame-ancestors 'none';",
        "EnableStrictTransportSecurity": true,
        "HstsMaxAgeSeconds": 31536000,
        "HstsIncludeSubDomains": true
      },
      "Identity": {
        "ServiceName": "ApiGateway"
      },
      "RateLimiting": {
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6,
        "UserReadLimit": 300,
        "UserWriteLimit": 30,
        "IpReadLimit": 1200,
        "IpWriteLimit": 120
      }
    }
  }
}