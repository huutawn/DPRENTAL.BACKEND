{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Authentication": {
      "ApiKey": {
        "RequiredRoutes": [
          "GET /api/v1/media/*/verify",
          "GET /api/v1/media/*",
          "POST /api/v1/media/*/access",
          "PUT /api/v1/media/*/visibility"
        ]
      },
       "Jwt": {
         "Issuer": "",
         "Audience": "",
        "InventoryAudience": "inventory-api",
         "JwksUri": ""
       }
    },
    "Security": {
      "Cors": {
        "AllowedOrigins": [],
        "AllowedMethods": [
          "GET",
          "POST",
          "PUT",
          "DELETE",
          "PATCH",
          "OPTIONS",
          "HEAD"
        ],
        "AllowedHeaders": [
          "Authorization",
          "Content-Type",
          "Idempotency-Key",
          "X-Correlation-ID",
          "Accept",
          "Origin",
          "X-Requested-With"
        ],
        "ExposedHeaders": [
          "X-Correlation-ID"
        ],
        "AllowCredentials": true,
        "PreflightMaxAgeSeconds": 3600
      },
      "ForwardedHeaders": {
        "Enabled": true,
        "ForwardLimit": 1,
        "KnownNetworks": [],
        "KnownProxies": []
      },
      "RequestSize": {
        "MaxRequestBodySizeBytes": 10485760,
        "MediaUploadMaxRequestBodySizeBytes": 26214400
      },
      "Headers": {
        "EnableContentTypeOptions": true,
        "EnableFrameOptions": true,
        "FrameOptions": "DENY",
        "EnableXssProtection": true,
        "XssProtection": "0",
        "EnableReferrerPolicy": true,
        "ReferrerPolicy": "strict-origin-when-cross-origin",
        "EnableContentSecurityPolicy": true,
        "ContentSecurityPolicy": "default-src 'self'; frame-ancestors 'none';",
        "EnableStrictTransportSecurity": true,
        "HstsMaxAgeSeconds": 31536000,
        "HstsIncludeSubDomains": true
      },
      "Identity": {
        "ServiceName": "ApiGateway"
      }
    }
  },
  "Routes": [
    {
      "Key": "auth-service-google-provider-callback",
      "UpstreamPathTemplate": "/signin-google",
      "DownstreamPathTemplate": "/signin-google",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-service",
          "Port": 5000
        }
      ],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "Key": "auth-service",
      "UpstreamPathTemplate": "/api/v1/auth/{everything}",
      "DownstreamPathTemplate": "/api/v1/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-service",
          "Port": 5000
        }
      ],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "Key": "auth-service-openapi",
      "UpstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-service",
          "Port": 5000
        }
      ],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "Key": "media-service-public-content",
      "UpstreamPathTemplate": "/api/v1/media/{mediaId}/content",
      "DownstreamPathTemplate": "/api/v1/media/{mediaId}/content",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "media-service", "Port": 8080 }],
      "AuthenticationOptions": { "AllowAnonymous": true }
    },
    {
      "Key": "media-service",
      "UpstreamPathTemplate": "/api/v1/media/{everything}",
      "DownstreamPathTemplate": "/api/v1/media/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "media-service", "Port": 8080 }],
      "Timeout": 60,
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      "Key": "media-service-openapi",
      "UpstreamPathTemplate": "/media/swagger/v1/swagger.json",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "media-service", "Port": 8080 }],
      "AuthenticationOptions": { "AllowAnonymous": true }
    },
    {
      "Key": "inventory-service",
      "UpstreamPathTemplate": "/api/v1/inventory/{everything}",
      "DownstreamPathTemplate": "/api/v1/inventory/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "inventory-service", "Port": 8080 }],
      "Timeout": 60,
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["InventoryBearer"] }
    },
    {
      "Key": "inventory-service-openapi",
      "UpstreamPathTemplate": "/inventory/swagger/v1/swagger.json",
      "DownstreamPathTemplate": "/swagger/v1/swagger.json",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "inventory-service", "Port": 8080 }],
      "AuthenticationOptions": { "AllowAnonymous": true }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5050",
    "Timeout": 10,
    "AuthenticationOptions": {
      "AuthenticationProviderKeys": [
        "Bearer"
      ]
    }
  }
}
