# Copy this file to /opt/dprental/dev/release.env. Do not commit that file.
# CI updates only the relevant immutable SHA tag; do not use latest.
# Replace `your-org` with the GitHub Environment's GHCR_IMAGE_NAMESPACE first.

GATEWAY_IMAGE=ghcr.io/your-org/dprental-gateway:replace-with-git-sha
AUTH_SERVICE_IMAGE=ghcr.io/your-org/dprental-auth:replace-with-git-sha
AUTH_MIGRATOR_IMAGE=ghcr.io/your-org/dprental-auth-migrator:replace-with-git-sha
FRONTEND_IMAGE=ghcr.io/your-org/dprental-frontend:replace-with-git-sha
MEDIA_SERVICE_IMAGE=ghcr.io/your-org/dprental-media:replace-with-git-sha
MEDIA_MIGRATOR_IMAGE=ghcr.io/your-org/dprental-media-migrator:replace-with-git-sha
CATALOG_SERVICE_IMAGE=ghcr.io/your-org/dprental-catalog:replace-with-git-sha
CATALOG_MIGRATOR_IMAGE=ghcr.io/your-org/dprental-catalog-migrator:replace-with-git-sha
INVENTORY_SERVICE_IMAGE=ghcr.io/your-org/dprental-inventory:replace-with-git-sha
INVENTORY_MIGRATOR_IMAGE=ghcr.io/your-org/dprental-inventory-migrator:replace-with-git-sha
RENTAL_SERVICE_IMAGE=ghcr.io/your-org/dprental-rental:replace-with-git-sha
RENTAL_MIGRATOR_IMAGE=ghcr.io/your-org/dprental-rental-migrator:replace-with-git-sha
