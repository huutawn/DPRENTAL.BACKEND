# Copy this file to /opt/dprental/dev/.env on the VPS. Do not commit that file.
# Each application image must use an immutable commit-SHA tag, never `latest`.

DEV_DOMAIN=dev-api.lazyops.cloud
DEV_APP_DOMAIN=dev-app.lazyops.cloud
CADDY_ACME_EMAIL=ops@example.com
CADDY_IMAGE=caddy:2.10.2-alpine
# Opsi tunnel proxy chuyển tiếp public 80/443 vào hai cổng loopback này.
OPSI_HTTP_LOCAL_PORT=18080
OPSI_HTTPS_LOCAL_PORT=18443

POSTGRES_IMAGE=postgres:17.11-alpine3.24
VALKEY_IMAGE=valkey/valkey:8.1.10-alpine3.24
MEDIA_MINIO_IMAGE=ghcr.io/coollabsio/minio@sha256:69b55a1c1c5dc285ce04db96689f5b2102317fc77a50680a1874ca6efd1c87f9

ASPNETCORE_ENVIRONMENT=Staging
EDGE_NETWORK_CIDR=172.30.0.0/24
SECRETS_DIR=/opt/dprental/dev/secrets

POSTGRES_DB=authservice
POSTGRES_USER=authservice
# Generate a unique high-entropy password. This value is secret.
POSTGRES_PASSWORD=replace-with-a-secret

# MediaService dùng cùng PostgreSQL database ở schema media; MinIO vẫn tách riêng.
MEDIA_MINIO_ROOT_USER=mediaadmin
MEDIA_MINIO_ROOT_PASSWORD=replace-with-another-secret

AUTH_JWT_ISSUER=https://dev-api.lazyops.cloud
AUTH_JWT_AUDIENCE=dprental-clients
AUTH_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
AUTH_JWT_ACTIVE_KEY_ID=dev-2026-01
AUTH_ADMIN_BOOTSTRAP_CREATION_KEY=replace-with-a-secret-shared-by-auth-and-media

CORS_ALLOWED_ORIGIN_0=https://dev-app.lazyops.cloud
MAX_REQUEST_BODY_SIZE_BYTES=10485760
MEDIA_UPLOAD_MAX_REQUEST_BODY_SIZE_BYTES=26214400
DEFAULT_TIMEOUT_SECONDS=10
RATE_LIMIT_ANONYMOUS_PERMIT=20
RATE_LIMIT_AUTHENTICATED_PERMIT=100
RATE_LIMIT_SENSITIVE_PERMIT=5
TRACING_SAMPLING_RATIO=0.1
OTLP_TRACES_ENDPOINT=
