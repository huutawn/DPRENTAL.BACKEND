{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "127.0.0.1:6379"
  },
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9092",
    "InventoryTopic": "inventory.behavior.events.v1",
    "InventoryConsumerGroup": "recommendation-inventory-behavior-v1",
    "InventoryDlqTopic": "inventory.behavior.events.v1.recommendation.dlq",
    "RentalTopic": "rental.events.v1",
    "RentalConsumerGroup": "recommendation-rental-behavior-v1",
    "RentalDlqTopic": "rental.events.v1.recommendation.dlq",
    "Enabled": true
  },
  "Valkey": {
    "Enabled": true,
    "IntervalSeconds": 60
  }
}
